# O fluxo principal (DOM / JSON / OCR local) funciona SEM chaves de IA.
# false: só o botão "Completar com IA" pode usar APIs.
IA_AUTOMATICA=false

# Visão opcional, para prints que o OCR/texto não resolver.
# Obtenha sua chave em https://aistudio.google.com/
GEMINI_API_KEY=

# Informe um modelo de visão disponível na sua conta do Google AI Studio.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=60
# Teto de tokens da resposta (não limita os tokens de entrada).
GEMINI_MAX_OUTPUT_TOKENS=2048

# IA de texto opcional: usada antes da visão quando o OCR ficou incompleto.
# Preencha a chave obtida em https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_ENABLED=true
GROQ_TIMEOUT_SECONDS=30
# Inclui os tokens de raciocínio do GPT-OSS.
GROQ_MAX_COMPLETION_TOKENS=2048
OCR_TIMEOUT_SECONDS=15

MOVIDESK_URL=https://grupohda.movidesk.com
MOVIDESK_LOGIN_TIMEOUT_SECONDS=120
# Espera pelo salvamento manual e retorno do número à fila (60–86400 segundos).
MOVIDESK_RETORNO_TIMEOUT_SECONDS=28800
